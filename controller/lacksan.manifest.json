      "protectedScopes": ["WindowsSecurity","WindowsUpdate","Recovery","EnterpriseManagement","DeviceCriticalDrivers","Omnissa","WindowsApp","RemoteDesktop","Tailscale"]
    },
    {
      "id": "logi-options-plus-run",
      "displayName": "Logi Options+ tray Run registration",
